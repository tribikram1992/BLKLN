# Journal Certification Platform - Environment Variables
# Copy this file to .env.local and update with your values
# DO NOT commit .env.local to version control

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=7000
FRONTEND_HOST=localhost
FRONTEND_PORT=7001
PROXY_PORT=7002

# Environment mode (development, staging, production)
ENV=development

# Enable debug mode (True or False)
DEBUG=True

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:ShankLuffy%5E1015r@localhost:5432/journal_certification

# Enable SQL query logging (True or False)
DATABASE_ECHO=False

# Database connection pool size
DATABASE_POOL_SIZE=20

# Maximum number of overflow connections
DATABASE_MAX_OVERFLOW=40

# ============================================================================
# JWT & AUTHENTICATION SETTINGS
# ============================================================================

# JWT secret key for token signing (MUST be changed in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=MrvlgFQK3bhjyha0A4PZVb678kpwhoEG4eg_xhywAl0

# JWT algorithm (recommended: HS256)
JWT_ALGORITHM=HS256

# JWT token expiration in hours
JWT_EXPIRATION_HOURS=24

# JWT refresh token expiration in days
JWT_REFRESH_EXPIRATION_DAYS=7

# ============================================================================
# SESSION MANAGEMENT
# ============================================================================

# Session expiration time in hours
SESSION_EXPIRATION_HOURS=24

# Session inactivity timeout in minutes
SESSION_INACTIVITY_TIMEOUT_MINUTES=30

# ============================================================================
# SECURITY POLICIES
# ============================================================================

# Minimum password length
PASSWORD_MIN_LENGTH=8

# Maximum failed login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in minutes
LOCKOUT_DURATION_MINUTES=15

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================

# Maximum file upload size in MB
MAX_UPLOAD_FILE_SIZE_MB=100

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Backend API URL (for frontend to call backend)
# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:7000

# Frontend Node environment
NODE_ENV=development

CORS_ORIGINS=http://localhost:7001,http://localhost:7002
#,http://jornalcertification.local:7002
