-- The DEFAULT 'JOURNAL' silently tags every pre-existing journal row without
-- touching those rows.  New account rows carry module = 'ACCOUNT'.  Application
-- code that queries this table must now include a module filter:
--   WHERE role_code = :role AND module = :module AND is_active = TRUE
