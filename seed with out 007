-- FILE: 03_user_roles.sql
-- =============================================================================
-- =============================================================================
-- Seed: 03_user_roles.sql
-- User-role assignments.
--
--   testuser1   → PREPARER + APPROVER   dual-role
--   testuser2   → PREPARER + APPROVER   dual-role
--   testuser3   → PREPARER              single-role control
--   testuser4   → APPROVER              single-role control
--   localadmin  → LOCAL_ADMIN + PREPARER
--   systemadmin → SYSTEM_ADMIN
--
-- testuser1 and testuser2 hold both journal roles because the fixture assigns
-- them opposite seats on different journals (14_test_journals.sql): testuser1
-- prepares TJ-A* and approves TJ-S*, testuser2 the mirror image. That is what
-- makes "scoped by (user, active role)" distinguishable from "scoped by user" —
-- with single-role accounts the two readings are indistinguishable.
--
-- localadmin additionally holds PREPARER so the role switcher can be exercised
-- across an admin/non-admin boundary: /admin must close while acting as
-- PREPARER even though the same person holds LOCAL_ADMIN.
--
-- Depends on: 01_roles.sql, 02_users.sql
-- Idempotent: ON CONFLICT (user_id, role_code) DO NOTHING.
-- =============================================================================

INSERT INTO user_roles (user_id, role_code, is_active, created_at)
SELECT
    u.user_id,
    mapping.role_code,
    TRUE,
    NOW()
FROM (
    VALUES
        ('testuser1',   'PREPARER'),
        ('testuser1',   'APPROVER'),
        ('testuser2',   'PREPARER'),
        ('testuser2',   'APPROVER'),
        ('testuser3',   'PREPARER'),
        ('testuser4',   'APPROVER'),
        ('localadmin',  'LOCAL_ADMIN'),
        ('localadmin',  'PREPARER'),
        ('systemadmin', 'SYSTEM_ADMIN')
) AS mapping(username, role_code)
JOIN users u ON u.username = mapping.username
ON CONFLICT (user_id, role_code) DO NOTHING;

-- Remove role grants from the retired identities (preparer/approver/
-- demopreparer/demoapprover). The user rows were renamed in place, so any role
-- they picked up under the old names would otherwise persist.
DELETE FROM user_roles ur
USING users u
WHERE ur.user_id = u.user_id
  AND u.username IN ('testuser3', 'testuser4')
  AND ur.role_code NOT IN (
      SELECT m.role_code FROM (
          VALUES ('testuser3', 'PREPARER'), ('testuser4', 'APPROVER')
      ) AS m(username, role_code)
      WHERE m.username = u.username
  );



